---
interface Props {
  companyName?: string;
}

const { companyName = "Motion Mark" } = Astro.props;
---

<section id="about" class="relative overflow-hidden bg-white py-24">

  <!-- Background Glow -->
  <div class="absolute inset-0 -z-10">

    <div class="absolute -left-40 top-0 h-[450px] w-[450px] rounded-full bg-blue-500/10 blur-3xl"></div>

    <div class="absolute right-0 bottom-0 h-[400px] w-[400px] rounded-full bg-cyan-400/10 blur-3xl"></div>

  </div>

  <div class="mx-auto grid max-w-7xl items-center gap-16 px-6 lg:grid-cols-[1.15fr_0.85fr]">

    <!-- LEFT SIDE -->

    <div>

      <p class="mb-4 font-semibold uppercase tracking-[0.3em] text-blue-600">
        OUR STORY
      </p>

      <h2 class="mb-8 text-5xl font-black text-slate-900">
        More than just advertising.
        <span class="gradient-text block">
          We put your message in motion.
        </span>
      </h2>

      <div class="space-y-7 text-lg leading-9 text-slate-600">

        <p>
          <strong>Motion Mark</strong> was founded in <strong>2026</strong> with a simple vision:
          to redefine outdoor advertising through innovative mobile LED technology.
          We believe advertising should never be confined to one location. Instead,
          it should travel, connect with people and create memorable brand experiences
          wherever it goes.
        </p>

        <p>
          Founded by <strong>Rachel Langman</strong>, Motion Mark was built on the belief
          that businesses deserve advertising solutions that are as dynamic as the
          audiences they want to reach. By combining premium LED display technology
          with strategic mobility, we help brands stand out in a crowded world.
        </p>

        <p>
          Based in <strong>Cape Town</strong>, we work with businesses, event organisers
          and agencies to create campaigns that capture attention where it matters
          most. Whether it's promoting a product launch, supporting a community
          event or building long-term brand awareness, every campaign is planned
          with creativity, professionalism and purpose.
        </p>

        <p class="border-l-4 border-cyan-400 pl-6 italic text-slate-700">
          "Every kilometre travelled is another opportunity to put your message in motion."
        </p>

      </div>

      <!-- Company Highlights -->

      <div class="mt-12 flex flex-wrap gap-4">

        <div class="rounded-full border border-slate-200 bg-slate-50 px-5 py-3 font-medium text-slate-700 shadow-sm">
          📍 Cape Town Based
        </div>

        <div class="rounded-full border border-slate-200 bg-slate-50 px-5 py-3 font-medium text-slate-700 shadow-sm">
          🚚 Founded 2026
        </div>

        <div class="rounded-full border border-slate-200 bg-slate-50 px-5 py-3 font-medium text-slate-700 shadow-sm">
          💡 Founder-Led Business
        </div>

      </div>

    </div>

    <!-- RIGHT SIDE -->

    <div class="relative">

      <div class="overflow-hidden rounded-[36px] border border-white/50 bg-white p-4 shadow-2xl">

        <img
          src="/images/about-placeholder.jpg"
          alt="Motion Mark Story"
          class="h-full w-full rounded-[28px] object-cover"
        />

      </div>

      <!-- Floating Card -->

      <div class="absolute -bottom-8 left-8 rounded-3xl border border-white/60 bg-white/90 p-6 shadow-xl backdrop-blur-xl">

        <p class="text-sm uppercase tracking-[0.2em] text-slate-500">
          Founded
        </p>

        <h3 class="mt-1 text-4xl font-black gradient-text">
          2026
        </h3>

        <p class="mt-2 text-sm text-slate-500">
          Cape Town, South Africa
        </p>

      </div>

    </div>

  </div>

</section>