<section class="relative h-40 overflow-hidden bg-transparent">

  <div class="road"></div>

  <div class="truck">

    <div class="cab"></div>

    <div class="screen">

      <div class="led-text">
        MOTION MARK
      </div>

    </div>

    <div class="wheel wheel1"></div>
    <div class="wheel wheel2"></div>

  </div>

</section>

<style>

section{
    margin-top:40px;
}

.road{

    position:absolute;
    bottom:40px;

    width:100%;
    height:6px;

    background:#d1d5db;
}

.truck{

    position:absolute;

    bottom:46px;

    left:0px;

    width:260px;

    height:80px;

    animation:drive 14s linear infinite;
}

.screen{

    position:absolute;

    right:0;

    width:170px;

    height:80px;

    border-radius:12px;

    background:linear-gradient(
    90deg,
    #2563eb,
    #06b6d4,
    #84cc16,
    #eab308,
    #ea580c
    );

    display:flex;

    align-items:center;

    justify-content:center;

    color:white;

    font-weight:800;

    overflow:hidden;
}

.cab{

    position:absolute;

    left:0;

    bottom:0;

    width:90px;

    height:60px;

    border-radius:14px;

    background:#1e293b;
}

.wheel{

    position:absolute;

    width:22px;

    height:22px;

    background:#111827;

    border-radius:50%;

    bottom:-10px;

    animation:spin .6s linear infinite;
}

.wheel1{
left:20px;
}

.wheel2{
right:30px;
}

.led-text{

    animation:change 6s infinite;

    font-size:13px;
}

@keyframes drive {

  0% {
    left: 110%;
  }

  100% {
    left: -320px;
  }

}

@keyframes spin{

from{
transform:rotate(0deg);
}

to{
transform:rotate(360deg);
}

}

@keyframes change{

0%,30%{
opacity:1;
}

35%{
opacity:0;
}

40%,65%{
opacity:1;
}

70%{
opacity:0;
}

100%{
opacity:1;
}

}

</style>