---
interface Props {
  companyName?: string;
  phone?: string;
  email?: string;
  address?: string;
}

const {
  companyName = 'Motion Mark',
  phone = '+27 63 685 5083',
  email = 'info@motionmark.co.za',
  address = 'Cape Town, Western Cape',
} = Astro.props;
---

<section id="contact" class="contact-section">

  <div class="container">

    <div class="contact-content">

      <span class="contact-eyebrow">
        GET IN TOUCH
      </span>

      <h2 class="contact-title">
        Contact Us
      </h2>

      <p class="contact-lead">
        Need a quote or want to book a delivery? Reach out — we usually
        reply within a business day.
      </p>

      <ul class="contact-list">

        <li class="contact-item">
          <strong>Phone</strong>

          <a href={`tel:${phone.replace(/\s+/g, '')}`}>
            {phone}
          </a>
        </li>

        <li class="contact-item">
          <strong>Email</strong>

          <a href={`mailto:${email}`}>
            {email}
          </a>
        </li>

        <li class="contact-item">
          <strong>Address</strong>

          <span>
            {address}
          </span>
        </li>

      </ul>


      <!-- Social Buttons -->

      <div class="contact-socials">

        <a
          href="https://www.facebook.com/share/1R7wnJ418F/?mibextid=wwXIfr"
          class="contact-social-button"
          target="_blank"
          rel="noopener noreferrer"
        >
          Facebook
        </a>

        <a
          href="https://www.instagram.com/motionmarksa/"
          class="contact-social-button"
          target="_blank"
          rel="noopener noreferrer"
        >
          Instagram
        </a>

        <a
          href="http://wa.me/27636855083"
          class="contact-social-button"
          target="_blank"
          rel="noopener noreferrer"
        >
          WhatsApp
        </a>

      </div>

    </div>

  </div>

</section>


<footer class="motion-footer">

  <div class="footer-inner">

    <p>
      © {new Date().getFullYear()} {companyName}. All rights reserved.
    </p>

    <p>
      <span>Designed by</span>

      <span class="dextera">
        Dextera Digital
      </span>
    </p>

  </div>

</footer>


<style>

  /* ============================================
     CONTACT
     ============================================ */

  .contact-section {

    background: #081a33;

    color: #ffffff;

    padding-top: 5rem;

    padding-bottom: 3rem;

  }


  .contact-content {

    max-width: 700px;

  }


  /* ============================================
     HEADING
     ============================================ */

  .contact-eyebrow {

    display: block;

    margin-bottom: .75rem;

    color: var(--cyan);

    font-size: .8rem;

    font-weight: 700;

    letter-spacing: .25rem;

    text-transform: uppercase;

  }


  .contact-title {

    margin: 0 0 1rem;

    color: #ffffff;

    font-family: var(--heading-font);

    font-size: clamp(2.5rem, 6vw, 4rem);

    font-weight: 900;

    line-height: 1.05;

  }


  .contact-lead {

    max-width: 420px;

    margin: 0;

    color: rgba(255,255,255,.8);

    font-size: 1.05rem;

    line-height: 1.8;

  }


  /* ============================================
     CONTACT DETAILS
     ============================================ */

  .contact-list {

    list-style: none;

    padding: 0;

    margin: 2rem 0 0;

    display: flex;

    flex-direction: column;

    gap: 1rem;

  }


  .contact-item {

    display: flex;

    flex-direction: column;

    gap: .2rem;

  }


  .contact-item strong {

    color: var(--cyan);

    font-size: .75rem;

    font-weight: 700;

    letter-spacing: .08em;

    text-transform: uppercase;

  }


  .contact-item a,

  .contact-item span {

    color: #ffffff;

    font-size: 1rem;

    font-weight: 500;

    text-decoration: none;

  }


  .contact-item a:hover {

    color: var(--cyan);

    text-decoration: underline;

  }


  /* ============================================
     SOCIAL BUTTONS
     ============================================ */

  .contact-socials {

    display: flex;

    flex-wrap: wrap;

    gap: .8rem;

    margin-top: 2rem;

  }


  .contact-social-button {

    display: inline-flex;

    align-items: center;

    justify-content: center;

    min-width: 100px;

    min-height: 44px;

    padding: .65rem 1.25rem;

    background: rgba(255,255,255,.08);

    border: 2px solid rgba(255,255,255,.5);

    border-radius: 999px;

    color: #ffffff !important;

    font-size: .85rem;

    font-weight: 700;

    line-height: 1;

    text-align: center;

    text-decoration: none !important;

    opacity: 1;

    visibility: visible;

    position: relative;

    z-index: 2;

    transition:
      background .25s ease,
      border-color .25s ease,
      transform .25s ease;

  }


  .contact-social-button:hover {

    background: rgba(255,255,255,.18);

    border-color: var(--cyan);

    color: #ffffff !important;

    transform: translateY(-2px);

  }


  /* ============================================
     FOOTER
     ============================================ */

  .motion-footer {

    background: #081a33;

    padding: 1.25rem 0;

    border-top: 1px solid rgba(255,255,255,.1);

  }


  .footer-inner {

    width: min(var(--max-width), 92%);

    margin: 0 auto;

    display: flex;

    align-items: center;

    justify-content: space-between;

    gap: 1rem;

  }


  .footer-inner p {

    margin: 0;

    color: rgba(255,255,255,.6);

    font-size: .8rem;

  }


  .dextera {

    margin-left: .3rem;

    font-weight: 700;

    background: linear-gradient(
      90deg,
      var(--blue),
      var(--cyan),
      var(--orange)
    );

    background-clip: text;

    -webkit-background-clip: text;

    color: transparent;

    -webkit-text-fill-color: transparent;

  }


  /* ============================================
     MOBILE
     ============================================ */

  @media (max-width: 720px) {

    .contact-section {

      padding-top: 4rem;

      padding-bottom: 2.5rem;

    }


    .contact-content {

      max-width: 100%;

    }


    .contact-title {

      font-size: 2.75rem;

    }


    .contact-lead {

      font-size: 1rem;

      line-height: 1.7;

    }


    .contact-list {

      margin-top: 1.75rem;

    }


    .contact-socials {

      gap: .6rem;

      margin-top: 1.75rem;

    }


    .contact-social-button {

      min-width: 0;

      padding: .65rem 1rem;

    }


    .footer-inner {

      flex-direction: column;

      justify-content: center;

      text-align: center;

      gap: .35rem;

    }

  }

</style>