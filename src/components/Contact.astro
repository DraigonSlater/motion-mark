---
interface Props {
  companyName?: string;
  phone?: string;
  email?: string;
  address?: string;
  socials?: { label: string; href: string }[];
}

const {
  companyName = 'Motion Mark',
  phone = '+27 63 685 5083',
  email = 'info@motionmark.co.za',
  address = 'Cape Town, Western Cape',
  socials = [
    {
      label: 'Facebook',
      href: 'https://www.facebook.com/share/1R7wnJ418F/?mibextid=wwXIfr'
    },
    {
      label: 'Instagram',
      href: 'https://www.instagram.com/motionmarksa/'
    },
    {
      label: 'WhatsApp',
      href: 'http://wa.me/27636855083'
    },
  ],
} = Astro.props;
---

<section id="contact" class="contact">

  <div class="container">

    <div class="contact-content">

      <div>

        <span class="eyebrow">
          Get In Touch
        </span>

        <h2>
          Contact Us
        </h2>

        <p class="contact-lead">
          Need a quote or want to book a delivery? Reach out — we usually
          reply within a business day.
        </p>

        <ul class="contact-list">

          <li>
            <strong>Phone</strong>

            <a href={`tel:${phone.replace(/\s+/g, '')}`}>
              {phone}
            </a>
          </li>

          <li>
            <strong>Email</strong>

            <a href={`mailto:${email}`}>
              {email}
            </a>
          </li>

          <li>
            <strong>Address</strong>

            <span>
              {address}
            </span>
          </li>

        </ul>

        <div class="socials">

          <a
            href="https://www.facebook.com/share/1R7wnJ418F/?mibextid=wwXIfr"
            class="social-link"
            target="_blank"
            rel="noopener noreferrer"
          >
            Facebook
          </a>

          <a
            href="https://www.instagram.com/motionmarksa/"
            class="social-link"
            target="_blank"
            rel="noopener noreferrer"
          >
            Instagram
          </a>

          <a
            href="http://wa.me/27636855083"
            class="social-link"
            target="_blank"
            rel="noopener noreferrer"
          >
            WhatsApp
          </a>
        </div>

      </div>

    </div>

  </div>

</section>


<footer class="footer">

  <div class="border-t border-white/10 pt-6 text-center text-sm text-white/60">

    © {new Date().getFullYear()} {companyName}. All rights reserved.

    <span class="mx-2">•</span>

    Designed by

    <span class="font-semibold gradient-text">
      Dextera Digital
    </span>

  </div>

</footer>


<style>

  .contact {

    background: var(--color-primary);

    color: var(--color-white);

    padding-top: 5rem;

    padding-bottom: 2rem;

  }


  .contact-content {

    max-width: 700px;

  }


  .contact-lead {

    color: rgba(255,255,255,0.8);

    max-width: 420px;

  }


  .contact-list {

    list-style: none;

    padding: 0;

    margin: 1.5rem 0;

    display: flex;

    flex-direction: column;

    gap: 0.9rem;

  }


  .contact-list li {

    display: flex;

    flex-direction: column;

    gap: 0.15rem;

  }


  .contact-list strong {

    font-size: 0.75rem;

    text-transform: uppercase;

    letter-spacing: 0.08em;

    color: var(--color-accent);

  }


  .contact-list a,
  .contact-list span {

    color: var(--color-white);

    text-decoration: none;

    font-weight: 500;

  }


  .contact-list a:hover {

    text-decoration: underline;

  }


  .socials {

    display: flex;

    flex-wrap: wrap;

    gap: 1rem;

  }


  .social-link {
    display: inline-flex;
   align-items: center;
    justify-content: center;

   padding: 0.65rem 1.25rem;

   border: 2px solid rgba(255, 255, 255, 0.6);
   border-radius: 999px;

   background: rgba(255, 255, 255, 0.08);

   color: #ffffff !important;

    font-size: 0.85rem;
    font-weight: 600;

    text-decoration: none !important;

    opacity: 1;

    transition: all 0.25s ease;
  }

  .social-link:hover {
    background: rgba(255, 255, 255, 0.15);

    border-color: #ffffff;

    color: #ffffff !important;

    transform: translateY(-2px);
  }


  .footer {

    background: #081a33;

    color: rgba(255,255,255,0.6);

    padding: 1rem 0;

    font-size: 0.85rem;

  }


  @media (max-width: 720px) {

    .contact {

      padding-top: 4rem;

      padding-bottom: 2rem;

    }


    .contact-content {

      max-width: 100%;

    }


    .socials {
      display: flex;
      flex-wrap: wrap;
      gap: 1rem;

      margin-top: 2rem;
    }


    .footer {

      padding: 1rem 0;

    }

  }

</style>