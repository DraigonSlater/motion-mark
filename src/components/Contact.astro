---
interface Props {
  companyName?: string;
  phone?: string;
  email?: string;
  address?: string;
  socials?: { label: string; href: string }[];
}

const {
  companyName = 'Motion Mark',
  phone = '+27 63 685 5083',
  email = 'info@motionmark.co.za',
  address = 'Cape Town, Western Cape',
  socials = [
    { label: 'Facebook', href: 'https://www.facebook.com/share/1R7wnJ418F/?mibextid=wwXIfr' },
    { label: 'Instagram', href: 'https://www.instagram.com/motionmarksa/' },
    { label: 'WhatsApp', href: 'http://wa.me/27636855083' },
  ],
} = Astro.props;
---

<section id="contact" class="contact">
  <div class="container contact-grid">
    <div>
      <span class="eyebrow">Get In Touch</span>
      <h2>Contact Us</h2>
      <p class="contact-lead">
        Need a quote or want to book a delivery? Reach out — we usually
        reply within a business day.
      </p>

      <ul class="contact-list">
        <li>
          <strong>Phone</strong>
          <a href={`tel:${phone.replace(/\s+/g, '')}`}>{phone}</a>
        </li>
        <li>
          <strong>Email</strong>
          <a href={`mailto:${email}`}>{email}</a>
        </li>
        <li>
          <strong>Address</strong>
          <span>{address}</span>
        </li>
      </ul>

      <div class="socials">
        {socials.map((s) => (
          <a href={s.href} class="social-link">{s.label}</a>
        ))}
      </div>
    </div>

    <div class="contact-card">

      <p class="contact-card-title">
        Ready to get your message moving?
      </p>

      <p class="contact-card-text">
        Whether you're launching a new product, promoting an event or looking to
        increase your brand's visibility, we're here to help bring your campaign
        to life.
      </p>

      <a href="#contact" class="contact-card-button">
        Request a Quote
      </a>
    </div>
  </div>
</section>

<footer class="footer">
  <div class="border-t border-slate-200 pt-8 text-center text-sm text-slate-500">
  © {new Date().getFullYear()} Motion Mark. All rights reserved.
  <span class="mx-2">•</span>
  Designed by <span class="font-semibold gradient-text">Dextera Digital</span>
</div>
</footer>

<style>
  .contact {
    background: var(--color-primary);
    color: var(--color-white);

    padding-top: 5rem;
    padding-bottom: 2rem;
  }

  .contact-lead {
    color: rgba(255,255,255,0.8);
    max-width: 420px;
  }

  .contact-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3rem;
    align-items: start;
  }

  .contact-list {
    list-style: none;
    padding: 0;
    margin: 1.5rem 0;
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
  }

  .contact-list li {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  .contact-list strong {
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-accent);
  }

  .contact-list a, .contact-list span {
    color: var(--color-white);
    text-decoration: none;
    font-weight: 500;
  }

  .contact-list a:hover { text-decoration: underline; }

  .socials {
    display: flex;
    gap: 1rem;
  }

  .social-link {
    padding: 0.6rem 1.1rem;
    border: 2px solid rgba(255,255,255,0.4);
    border-radius: 999px;
    text-decoration: none;
    font-size: 0.85rem;
    font-weight: 600;
  }

  .social-link:hover { border-color: var(--color-white); }

  .contact-card{
    background:rgba(255,255,255,.08);

    border:1px solid rgba(255,255,255,.15);

    border-radius:24px;

    padding:3rem;

    display:flex;
    flex-direction:column;

    justify-content:center;

    min-height:340px;

    backdrop-filter:blur(12px);
  }

  .contact-card-title{

    font-size:2rem;

    font-weight:800;

    color:white;

    margin-bottom:1rem;

    line-height:1.2;
  }

  .contact-card-text{

    color:rgba(255,255,255,.75);

    line-height:1.8;

    margin-bottom:2rem;
  }

  .contact-card-button{

    display:inline-flex;

    justify-content:center;

    align-items:center;

    width:fit-content;

    padding:.9rem 2rem;

    border-radius:999px;

    background:linear-gradient(
        90deg,
        #2563EB,
        #06B6D4,
        #EA580C
    );

    color:white;

    font-weight:700;

    transition:.3s;
  }

  .contact-card-button:hover{

    transform:translateY(-4px);
  }

  .footer {
    background: #081a33;
    color: rgba(255,255,255,0.6);

    padding: 1rem 0;

    font-size: 0.85rem;
  }

  @media (max-width: 720px) {
    .contact-grid { grid-template-columns: 1fr; }
  }
</style>
