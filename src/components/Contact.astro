---
interface Props {
  companyName?: string;
  phone?: string;
  email?: string;
  address?: string;
  socials?: { label: string; href: string }[];
}

const {
  companyName = 'Motion Mark',
  phone = '+27 63 685 5083',
  email = 'info@motionmark.co.za',
  address = 'Cape Town, Western Cape',
  socials = [
    {
      label: 'Facebook',
      href: 'https://www.facebook.com/share/1R7wnJ418F/?mibextid=wwXIfr'
    },
    {
      label: 'Instagram',
      href: 'https://www.instagram.com/motionmarksa/'
    },
    {
      label: 'WhatsApp',
      href: 'http://wa.me/27636855083'
    },
  ],
} = Astro.props;
---

<section id="contact" class="contact">

  <div class="container">

    <!-- Heading -->

    <div class="contact-heading">

      <span class="eyebrow">
        GET IN TOUCH
      </span>

      <h2>
        Contact Us
      </h2>

      <p class="contact-lead">
        Need a quote or want to book a campaign? Reach out — we'd love to
        hear about your project and help put your message in motion.
      </p>

    </div>


    <!-- Contact Information -->

    <div class="contact-content">

      <div class="contact-details">

        <div class="contact-item">

          <span class="contact-label">
            Phone
          </span>

          <a
            href={`tel:${phone.replace(/\s+/g, '')}`}
            class="contact-value"
          >
            {phone}
          </a>

        </div>


        <div class="contact-item">

          <span class="contact-label">
            Email
          </span>

          <a
            href={`mailto:${email}`}
            class="contact-value"
          >
            {email}
          </a>

        </div>


        <div class="contact-item">

          <span class="contact-label">
            Based In
          </span>

          <span class="contact-value">
            {address}
          </span>

        </div>

      </div>


      <!-- Social Links -->

      <div class="socials">

        {socials.map((social) => (

          <a
            href={social.href}
            class="social-link"
            target="_blank"
            rel="noopener noreferrer"
          >
            {social.label}
          </a>

        ))}

      </div>

    </div>

  </div>

</section>


<!-- Footer -->

<footer class="footer">

  <div class="footer-inner">

    <p>
      © {new Date().getFullYear()} {companyName}. All rights reserved.
    </p>

    <p>
      Designed by
      <span class="gradient-text font-semibold">
        Dextera Digital
      </span>
    </p>

  </div>

</footer>


<style>

  /* ============================================
     Contact Section
     ============================================ */

  .contact {

    background: var(--color-primary);

    color: var(--color-white);

    /*
      We deliberately control the spacing here
      instead of relying on the global section padding.
    */

    padding-top: 5rem;

    padding-bottom: 3rem;

  }


  /* ============================================
     Heading
     ============================================ */

  .contact-heading {

    max-width: 700px;

    margin-bottom: 3rem;

  }


  .contact-heading .eyebrow {

    display: block;

    margin-bottom: .75rem;

    color: var(--color-accent);

    font-size: .8rem;

    font-weight: 700;

    letter-spacing: .25rem;

    text-transform: uppercase;

  }


  .contact-heading h2 {

    margin: 0 0 1rem;

    color: white;

    font-size: clamp(2.5rem, 6vw, 4rem);

    font-weight: 900;

    line-height: 1.05;

  }


  .contact-lead {

    max-width: 600px;

    margin: 0;

    color: rgba(255,255,255,.75);

    font-size: 1.05rem;

    line-height: 1.8;

  }


  /* ============================================
     Contact Content
     ============================================ */

  .contact-content {

    display: flex;

    flex-direction: column;

    gap: 2.5rem;

  }


  .contact-details {

    display: grid;

    grid-template-columns: repeat(3, 1fr);

    gap: 2rem;

  }


  .contact-item {

    display: flex;

    flex-direction: column;

    gap: .4rem;

  }


  .contact-label {

    color: var(--color-accent);

    font-size: .75rem;

    font-weight: 700;

    letter-spacing: .12rem;

    text-transform: uppercase;

  }


  .contact-value {

    color: white;

    font-size: 1.05rem;

    font-weight: 600;

    text-decoration: none;

    transition: .25s ease;

  }


  a.contact-value:hover {

    color: #67e8f9;

  }


  /* ============================================
     Social Links
     ============================================ */

  .socials {

    display: flex;

    flex-wrap: wrap;

    gap: .75rem;

  }


  .social-link {

    display: inline-flex;

    align-items: center;

    justify-content: center;

    padding: .65rem 1.2rem;

    border: 1px solid rgba(255,255,255,.3);

    border-radius: 999px;

    color: white;

    font-size: .85rem;

    font-weight: 600;

    text-decoration: none;

    transition: .25s ease;

  }


  .social-link:hover {

    border-color: white;

    background: rgba(255,255,255,.1);

    transform: translateY(-2px);

  }


  /* ============================================
     Footer
     ============================================ */

  .footer {

    background: #081a33;

    color: rgba(255,255,255,.6);

    padding: 1.25rem 0;

  }


  .footer-inner {

    width: min(1200px, 92%);

    margin: 0 auto;

    display: flex;

    align-items: center;

    justify-content: space-between;

    gap: 1rem;

    border-top: 1px solid rgba(255,255,255,.1);

    padding-top: 1.25rem;

  }


  .footer-inner p {

    margin: 0;

    color: rgba(255,255,255,.6);

    font-size: .8rem;

  }


  /* ============================================
     Mobile
     ============================================ */

  @media (max-width: 720px) {

    .contact {

      padding-top: 4rem;

      padding-bottom: 2.5rem;

    }


    .contact-heading {

      margin-bottom: 2.5rem;

    }


    .contact-heading h2 {

      font-size: 2.75rem;

    }


    .contact-lead {

      font-size: 1rem;

      line-height: 1.7;

    }


    .contact-details {

      grid-template-columns: 1fr;

      gap: 1.5rem;

    }


    .contact-content {

      gap: 2rem;

    }


    .socials {

      gap: .6rem;

    }


    .social-link {

      padding: .6rem 1rem;

    }


    .footer {

      padding: 1rem 0;

    }


    .footer-inner {

      flex-direction: column;

      justify-content: center;

      text-align: center;

      gap: .35rem;

      padding-top: 1rem;

    }

  }

</style>