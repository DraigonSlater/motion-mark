---
interface Props {
  title: string;
  description: string;
  image: string;
  bullets: string[];
  reverse?: boolean;
}

const {
  title,
  description,
  image,
  bullets,
  reverse = false,
} = Astro.props;
---

<section
  class:list={[
    "mx-auto grid max-w-7xl items-center gap-16 py-24 px-6 lg:grid-cols-2",
    reverse && "lg:[&>*:first-child]:order-2",
  ]}
>

  <div>
    <img
      src={image}
      alt={title}
      class="rounded-3xl shadow-2xl"
    />
  </div>

  <div>

    <h2 class="mb-6 text-5xl font-bold text-white">
      {title}
    </h2>

    <p class="mb-8 text-lg leading-8 text-gray-300">
      {description}
    </p>

    <ul class="space-y-4">

      {
        bullets.map((bullet) => (
          <li class="flex items-center gap-3 text-gray-200">
            <span class="text-orange-500">&#10003;</span>
            {bullet}
          </li>
        ))
      }

    </ul>

  </div>

</section>