---
// Reusable animated truck. Drop your logo file in /public/images/logo.png
// (or an SVG) and it will render on the side of the trailer.
interface Props {
  logoSrc?: string;
}
const { logoSrc = '/images/logo.png' } = Astro.props;
---

<div class="truck-track" aria-hidden="true">
  <div class="truck">
    <svg viewBox="0 0 240 110" width="240" height="110" xmlns="http://www.w3.org/2000/svg">
      <!-- ground shadow -->
      <ellipse cx="120" cy="102" rx="100" ry="6" fill="rgba(0,0,0,0.15)" />

      <!-- trailer -->
      <rect x="10" y="30" width="140" height="55" rx="4" fill="var(--color-white)" stroke="var(--color-primary)" stroke-width="3" />
      <!-- logo panel on trailer -->
      <foreignObject x="20" y="40" width="120" height="35">
        <div xmlns="http://www.w3.org/1999/xhtml" class="logo-panel">
          <img src={logoSrc} alt="Company logo" onerror="this.style.display='none'; this.nextElementSibling.style.display='block';" />
          <span class="logo-fallback">YOUR LOGO</span>
        </div>
      </foreignObject>

      <!-- cab -->
      <path d="M150 40 h35 a8 8 0 0 1 8 5 l12 20 a6 6 0 0 1 -6 10 h-49 z" fill="var(--color-accent)" stroke="var(--color-primary)" stroke-width="3" />
      <!-- cab window -->
      <path d="M170 45 h13 l8 14 h-21 z" fill="#cfe8fb" stroke="var(--color-primary)" stroke-width="2" />

      <!-- exhaust puffs -->
      <circle class="puff puff1" cx="8" cy="35" r="4" fill="#c9ccd1" />
      <circle class="puff puff2" cx="4" cy="30" r="5" fill="#c9ccd1" />
      <circle class="puff puff3" cx="0" cy="24" r="6" fill="#d8dade" />

      <!-- wheels -->
      <g class="wheel" style="transform-origin: 45px 88px;">
        <circle cx="45" cy="88" r="14" fill="#222" />
        <circle cx="45" cy="88" r="6" fill="#aaa" />
        <rect x="44" y="76" width="2" height="24" fill="#555" />
        <rect x="33" y="87" width="24" height="2" fill="#555" />
      </g>
      <g class="wheel" style="transform-origin: 105px 88px;">
        <circle cx="105" cy="88" r="14" fill="#222" />
        <circle cx="105" cy="88" r="6" fill="#aaa" />
        <rect x="104" y="76" width="2" height="24" fill="#555" />
        <rect x="93" y="87" width="24" height="2" fill="#555" />
      </g>
      <g class="wheel" style="transform-origin: 180px 88px;">
        <circle cx="180" cy="88" r="14" fill="#222" />
        <circle cx="180" cy="88" r="6" fill="#aaa" />
        <rect x="179" y="76" width="2" height="24" fill="#555" />
        <rect x="168" y="87" width="24" height="2" fill="#555" />
      </g>
    </svg>
  </div>
</div>

<style>
  .truck-track {
    width: 100%;
    overflow: hidden;
    line-height: 0;
  }

  .truck {
    display: inline-block;
    animation: drive 14s linear infinite, bounce 0.5s ease-in-out infinite alternate;
  }

  .logo-panel {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .logo-panel img {
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
  }

  .logo-fallback {
    display: none;
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 12px;
    color: var(--color-primary);
    letter-spacing: 0.05em;
  }

  .wheel {
    animation: spin 0.6s linear infinite;
  }

  .puff {
    opacity: 0;
    animation: puff 1.4s ease-out infinite;
  }
  .puff2 { animation-delay: 0.4s; }
  .puff3 { animation-delay: 0.8s; }

  @keyframes drive {
    from { transform: translateX(110vw); }
    to   { transform: translateX(-260px); }
  }

  @keyframes bounce {
    from { margin-top: 0px; }
    to   { margin-top: 3px; }
  }

  @keyframes spin {
    from { transform: rotate(0deg); }
    to   { transform: rotate(360deg); }
  }

  @keyframes puff {
    0%   { opacity: 0; transform: translate(0, 0) scale(0.6); }
    30%  { opacity: 0.6; }
    100% { opacity: 0; transform: translate(-18px, -14px) scale(1.4); }
  }

  @media (prefers-reduced-motion: reduce) {
    .truck, .wheel, .puff {
      animation: none !important;
    }
    .truck { transform: translateX(30vw); }
  }
</style>
