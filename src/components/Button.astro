---
interface Props {
  href: string;
  variant?: "primary" | "secondary";
}

const {
  href,
  variant = "primary",
} = Astro.props;
---

<a
  href={href}
  class:list={[
    "inline-flex items-center justify-center rounded-full px-7 py-3 font-semibold transition duration-300",
    variant === "primary"
      ? "bg-orange-500 text-white hover:bg-orange-600"
      : "border border-white/20 text-white hover:bg-white hover:text-black",
  ]}
>
  <slot />
</a>