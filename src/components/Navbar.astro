---
const links = [
  { name: "Home", href: "#" },
  { name: "Services", href: "#services" },
  { name: "Gallery", href: "#gallery" },
  { name: "About", href: "#about" },
  { name: "Contact", href: "#contact" },
];
---

<header id="navbar">

  <div class="navbar-inner">

    <!-- Logo -->
    <a href="/" class="brand">

      <div class="brand-mark">
        MM
      </div>

      <div class="brand-text">
        <h2>Motion Mark</h2>
        <p>Your Message. In Motion.</p>
      </div>

    </a>


    <!-- Desktop Navigation -->
    <nav class="desktop-nav">

      <ul>
        {
          links.map((link) => (
            <li>
              <a href={link.href} class="nav-link">
                {link.name}
              </a>
            </li>
          ))
        }
      </ul>

    </nav>


    <!-- Quote Button -->
    <a href="#contact" class="quote-button">
      Request a Quote
    </a>

  </div>

</header>


<script>
  const navbar = document.getElementById("navbar");

  if (navbar) {

    const updateNavbar = () => {

      if (window.scrollY > 30) {
        navbar.classList.add("scrolled");
      } else {
        navbar.classList.remove("scrolled");
      }

    };

    updateNavbar();

    window.addEventListener("scroll", updateNavbar, {
      passive: true
    });

  }
</script>


<style>

/* ============================================
   MAIN NAVBAR
   ============================================ */

#navbar {

  position: fixed;

  top: 0;
  left: 0;
  right: 0;

  width: 100%;

  z-index: 1000;

  transition:
    padding .55s cubic-bezier(.4, 0, .2, 1);

}


/* ============================================
   NAVBAR INNER
   ============================================ */

.navbar-inner {

  width: 100%;

  min-height: 96px;

  padding: 1rem 3rem;

  display: flex;

  align-items: center;

  justify-content: space-between;

  gap: 2rem;

  transition:
    min-height .55s cubic-bezier(.4, 0, .2, 1),
    max-width .55s cubic-bezier(.4, 0, .2, 1),
    padding .55s cubic-bezier(.4, 0, .2, 1),
    border-radius .55s cubic-bezier(.4, 0, .2, 1),
    background .55s cubic-bezier(.4, 0, .2, 1),
    box-shadow .55s cubic-bezier(.4, 0, .2, 1),
    backdrop-filter .55s ease;

}


/* ============================================
   BRAND
   ============================================ */

.brand {

  display: flex;

  align-items: center;

  gap: .9rem;

  flex-shrink: 0;

}


.brand-mark {

  width: 58px;
  height: 58px;

  display: flex;

  align-items: center;
  justify-content: center;

  border-radius: 16px;

  background:
    linear-gradient(
      135deg,
      #2563eb,
      #06b6d4,
      #ea580c
    );

  color: white;

  font-size: 1.25rem;

  font-weight: 900;

  box-shadow:
    0 8px 25px rgba(37, 99, 235, .2);

  transition:
    width .55s cubic-bezier(.4, 0, .2, 1),
    height .55s cubic-bezier(.4, 0, .2, 1),
    border-radius .55s cubic-bezier(.4, 0, .2, 1);

}


.brand-text h2 {

  margin: 0;

  color: #0f172a;

  font-family: var(--heading-font);

  font-size: 1.5rem;

  font-weight: 900;

  line-height: 1;

  transition:
    font-size .55s cubic-bezier(.4, 0, .2, 1),
    color .35s ease;

}


.brand-text p {

  margin: .35rem 0 0;

  color: #64748b;

  font-size: .78rem;

  line-height: 1.2;

  transition:
    color .35s ease,
    opacity .35s ease;

}


/* ============================================
   DESKTOP NAVIGATION
   ============================================ */

.desktop-nav {

  flex: 1;

  display: flex;

  justify-content: center;

}


.desktop-nav ul {

  display: flex;

  align-items: center;

  gap: 2.5rem;

  margin: 0;

  padding: 0;

  list-style: none;

}


.nav-link {

  position: relative;

  color: #0f172a;

  font-size: .95rem;

  font-weight: 700;

  transition:
    color .3s ease;

}


.nav-link:hover {

  color: #2563eb;

}


.nav-link::after {

  content: "";

  position: absolute;

  left: 0;

  bottom: -8px;

  width: 0;

  height: 3px;

  border-radius: 999px;

  background:
    linear-gradient(
      90deg,
      #2563eb,
      #06b6d4,
      #84cc16,
      #eab308,
      #ea580c
    );

  transition:
    width .3s cubic-bezier(.4, 0, .2, 1);

}


.nav-link:hover::after {

  width: 100%;

}


/* ============================================
   QUOTE BUTTON
   ============================================ */

.quote-button {

  min-width: 155px;

  min-height: 52px;

  padding: .7rem 1.3rem;

  display: inline-flex;

  align-items: center;

  justify-content: center;

  text-align: center;

  border-radius: 999px;

  background:
    linear-gradient(
      90deg,
      #2563eb,
      #06b6d4,
      #ea580c
    );

  color: #ffffff;

  font-size: .9rem;

  font-weight: 800;

  line-height: 1.2;

  text-decoration: none;

  flex-shrink: 0;

  box-shadow:
    0 8px 20px rgba(37, 99, 235, .18);

  transition:
    transform .25s ease,
    min-height .55s cubic-bezier(.4, 0, .2, 1),
    min-width .55s cubic-bezier(.4, 0, .2, 1),
    padding .55s cubic-bezier(.4, 0, .2, 1),
    box-shadow .3s ease;

}


.quote-button:hover {

  transform:
    translateY(-2px)
    scale(1.02);

  box-shadow:
    0 12px 28px rgba(37, 99, 235, .25);

}


/* ============================================
   SCROLLED STATE
   ============================================ */

#navbar.scrolled {

  padding: .65rem 1rem;

}


#navbar.scrolled .navbar-inner {

  max-width: 1400px;

  min-height: 70px;

  margin: 0 auto;

  padding: .45rem 1.25rem;

  border-radius: 18px;

  background:
    rgba(255, 255, 255, .94);

  border:
    1px solid rgba(15, 23, 42, .08);

  box-shadow:
    0 10px 35px rgba(15, 23, 42, .12);

  backdrop-filter:
    blur(18px);

  -webkit-backdrop-filter:
    blur(18px);

}


#navbar.scrolled .brand-mark {

  width: 48px;

  height: 48px;

  border-radius: 14px;

}


#navbar.scrolled .brand-text h2 {

  font-size: 1.25rem;

  color: #0f172a;

}


#navbar.scrolled .brand-text p {

  color: #64748b;

}


#navbar.scrolled .nav-link {

  color: #0f172a;

}


#navbar.scrolled .quote-button {

  min-width: 140px;

  min-height: 46px;

  padding: .55rem 1rem;

}


/* ============================================
   MOBILE
   ============================================ */

@media (max-width: 900px) {

  #navbar {

    padding: 0;

  }


  .navbar-inner {

    min-height: 76px;

    padding: .7rem 1rem;

    gap: .6rem;

  }


  .desktop-nav {

    display: none;

  }


  .brand {

    gap: .65rem;

    min-width: 0;

  }


  .brand-mark {

    width: 48px;

    height: 48px;

    border-radius: 14px;

    font-size: 1rem;

    flex-shrink: 0;

  }


  .brand-text {

    min-width: 0;

  }


  .brand-text h2 {

    font-size: 1.2rem;

    white-space: nowrap;

  }


  .brand-text p {

    display: none;

  }


  .quote-button {

    min-width: 112px;

    min-height: 46px;

    padding: .55rem .75rem;

    font-size: .78rem;

    line-height: 1.15;

  }


  /* ==========================================
     MOBILE SCROLLED
     ========================================== */

  #navbar.scrolled {

    padding: .4rem .5rem;

  }


  #navbar.scrolled .navbar-inner {

    min-height: 62px;

    padding: .4rem .6rem;

    border-radius: 15px;

  }


  #navbar.scrolled .brand-mark {

    width: 42px;

    height: 42px;

    border-radius: 12px;

  }


  #navbar.scrolled .brand-text h2 {

    font-size: 1.05rem;

  }


  #navbar.scrolled .quote-button {

    min-width: 105px;

    min-height: 42px;

    padding: .45rem .65rem;

    font-size: .72rem;

  }

}


/* ============================================
   SMALL PHONES
   ============================================ */

@media (max-width: 380px) {

  .navbar-inner {

    padding-left: .6rem;

    padding-right: .6rem;

  }


  .brand-mark {

    width: 44px;

    height: 44px;

  }


  .brand-text h2 {

    font-size: 1.05rem;

  }


  .quote-button {

    min-width: 100px;

    font-size: .7rem;

  }

}

</style>