---
import Layout from "../layouts/Layout.astro";

import Hero from "../components/Hero.astro";
import WhyChoose from "../components/WhyChoose.astro";
import Services from "../components/Services.astro";
import Stats from "../components/Stats.astro";
import About from "../components/About.astro";
import Contact from "../components/Contact.astro";
import Gallery from "../components/Gallery.astro";
import MovingTruck from "../components/MovingTruck.astro";

const companyName = "Motion Mark";
const slogan = "Your Message. In Motion.";
---

<Layout
  title={`${companyName} | Mobile LED Advertising`}
  description={slogan}
>

  <Hero />

  <MovingTruck />

  <WhyChoose />

  <Services />

  <Stats />

  <Gallery />

  <About />

  <Contact />

</Layout>